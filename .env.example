APP_NAME=EduMindAI
APP_VERSION=1.0.0
APP_DESCRIPTION=Online learning platform

POSTGRES_DB=edumind
POSTGRES_USER=edumind_user
POSTGRES_PASSWORD=replace_with_a_long_random_password

DATABASE_URL=postgresql+psycopg://edumind_user:replace_with_a_long_random_password@postgres:5432/edumind
TEST_DATABASE_URL=postgresql+psycopg://edumind_user:replace_with_a_long_random_password@postgres:5432/edumind_test

SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CELERY_BROKER_URL=redis://redis:6379/0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ENVIRONMENT=production
PAYMENT_PROVIDER=disabled